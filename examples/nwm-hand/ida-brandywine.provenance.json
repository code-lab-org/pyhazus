  "text": "# Remnants of Hurricane Ida, 1-3 September 2021, New Castle County, Delaware.\n# Paths are relative to the directory the workflow is run from (the repository root here).\n\n[paths]\nwork = \"work/ida-ref\"\n\n[tools]\n# pyhazus command-line program, from its own environment (see README.md; bin/hazus on Linux or macOS)\nhazus = \"work/pyhazus-env/Scripts/hazus.exe\"\n\n[region]\n# state inventories exported with `hazus inventory export-state` (see docs/region.md)\nstates = [\"work/states/DE\"]\ncounties = [\"10003\"]\n# year = 2021   # creation year for depreciation; default: the current year, as in Hazus\n\n[hand]\nversion = \"hand_fim_4_9_9_0\"                       # HAND data set (CIROH public bucket)\ncode = \"work/ida-ref/code/inundation-mapping\"      # NOAA-OWP/inundation-mapping clone\ncommit = \"bf70e85\"                                 # v4.10.2.1\n\n[event]\nstart = \"2021-09-01T00:00Z\"\nend = \"2021-09-03T23:00Z\"\nflows = \"nwm_ana\"          # \"nwm_ana\" (operational analysis & assimilation) or \"csv\" (flows_csv = \"...\")\n\n[evaluate]\nstn_event = 312            # USGS STN event \"2021 Ida\" (high-water marks)\n"
